{"id": "reg-mvp-pinned", "kind": "regression", "stage": "mvp", "input": {"file": "output/mvp/events.json"}, "expect": {"nodes": 10, "rows": 10}, "note": "The pinned MVP picks must keep rendering as the 10-event timeline on the portfolio."}
{"id": "reg-m0-pinned", "kind": "regression", "stage": "m0", "input": {"file": "output/m0/events.json"}, "expect": {"nodes": 20, "edges": 29, "lanes": 4, "rows": 20}, "note": "The pinned M0 graph: 20 events, 29 arrows, 4 lanes. Arrows through nodes are a known defect, tracked by a capability case.", "skip": ["edges_avoid_nodes"]}
{"id": "reg-m1-pinned", "kind": "regression", "stage": "m1", "input": {"file": "output/m1/events.json"}, "expect": {"nodes": 19, "edges": 36, "lanes": 3, "rows": 30}, "note": "The pinned M1 pool with its 5 judge runs: 19 of 30 kept, as published. Arrows through nodes are a known defect, tracked by a capability case.", "skip": ["edges_avoid_nodes"]}
{"id": "reg-mvp-escapes-markup", "kind": "regression", "stage": "mvp", "input": {"events": [{"title": "Cal & Aron <b>argue</b>", "summary": "<script>alert(1)</script> & more"}, {"title": "Reveal \"at\" Kate's", "characters": ["Cal <i>", "Aron"]}]}, "note": "Model text is untrusted: markup in titles, summaries and names must be escaped."}
{"id": "reg-m0-escapes-markup", "kind": "regression", "stage": "m0", "input": {"events": [{"title": "Lee <reads> Marcus Aurelius", "rationale": "a & b < c"}, {"title": "Reveal", "causes": ["e0"], "thread": "Lee"}]}, "note": "Same, through the swimlane renderer."}
{"id": "reg-m0-skips-unknown-cause", "kind": "regression", "stage": "m0", "input": {"events": [{"title": "Start"}, {"title": "Middle", "causes": ["e0", "ghost"], "thread": "Hamilton"}, {"title": "Reveal", "causes": ["e1"]}]}, "checks": ["svg_well_formed", "one_node_per_event", "edges_match_causes"], "note": "The validator reports unknown causes; the SVG must still draw every known arrow."}
{"id": "reg-m0-four-lanes-in-order", "kind": "regression", "stage": "m0", "input": {"synthetic": {"n": 12, "threads": ["Lee", "Hamilton", "Cathy/Kate", "Trask"], "links": "per_thread"}}, "note": "Lanes come in the fixed thread order, whatever order the events use them in. Arrows through nodes are a known defect, tracked by a capability case.", "skip": ["edges_avoid_nodes"]}
{"id": "cap-m0-dangling-cause-mermaid", "kind": "capability", "stage": "m0", "input": {"events": [{"title": "Start"}, {"title": "Middle", "causes": ["e0", "ghost"], "thread": "Hamilton"}, {"title": "Reveal", "causes": ["e1"]}]}, "checks": ["mermaid_consistent"], "note": "Mermaid should skip an unknown cause, as the SVG does, not draw a stray box."}
{"id": "cap-m0-pinned-arrows-clear-nodes", "kind": "capability", "stage": "m0", "input": {"file": "output/m0/events.json"}, "checks": ["edges_avoid_nodes"], "note": "Known defect, confirmed in Chromium 2026-10-27: an S-curve between lanes runs through a node in a lane it crosses."}
{"id": "cap-m1-pinned-arrows-clear-nodes", "kind": "capability", "stage": "m1", "input": {"file": "output/m1/events.json"}, "checks": ["edges_avoid_nodes"], "note": "Same defect on the published M1 graph."}
{"id": "cap-mvp-long-titles", "kind": "capability", "stage": "mvp", "input": {"synthetic": {"n": 10, "title_words": 14, "seed": 3}}, "note": "Long titles wrap; do neighbouring labels collide or run off the edge?"}
{"id": "cap-mvp-unbroken-word", "kind": "capability", "stage": "mvp", "input": {"events": [{"title": "Supercalifragilisticexpialidociousness of Samuel Hamilton"}, {"title": "Reveal"}]}, "note": "A word longer than the wrap width, on the first node, near the left edge."}
{"id": "cap-m0-long-titles", "kind": "capability", "stage": "m0", "input": {"synthetic": {"n": 16, "threads": ["Trask", "Cathy/Kate", "Lee"], "title_words": 18, "seed": 5}}, "note": "Titles cut at four lines with an ellipsis; does the hover still hold the full title?"}
{"id": "cap-m0-dense-cross-lane", "kind": "capability", "stage": "m0", "input": {"synthetic": {"n": 24, "threads": ["Trask", "Cathy/Kate", "Hamilton", "Lee"], "links": "dense", "extra": 2, "seed": 1}}, "note": "Many arrows crossing lanes: do any run through other nodes?"}
{"id": "cap-m0-long-jump-in-lane", "kind": "capability", "stage": "m0", "input": {"synthetic": {"n": 20, "threads": ["Trask", "Lee"], "links": "chain", "seed": 2}, "mutate": [{"event": 19, "field": "causes", "append": ["e0", "e2", "e10"]}]}, "note": "Arcs over many columns in one lane stay inside the lane and clear the nodes."}
{"id": "cap-m0-single-event", "kind": "capability", "stage": "m0", "input": {"events": [{"title": "Reveal"}]}, "note": "Degenerate graph: only the reveal."}
{"id": "cap-m1-unjudged-pool", "kind": "capability", "stage": "m1", "input": {"synthetic": {"n": 30, "threads": ["Trask", "Cathy/Kate", "Lee"], "links": "dense", "extra": 1, "seed": 4}}, "note": "An M1 pool before any judge run: every candidate drawn."}
{"id": "cap-agent-mvp", "kind": "capability", "stage": "mvp", "input": {"agent": {"count": 10}}, "note": "The agent picks 10 linear events; its plot line must pass every check."}
{"id": "cap-agent-m0", "kind": "capability", "stage": "m0", "input": {"agent": {"count": 20}}, "note": "The agent picks a 20-event cause graph; its swimlanes must pass every check."}
